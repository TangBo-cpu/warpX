{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WrapX",
  "version": "0.5.0-alpha.0",
  "identifier": "run.hapi.wrapx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WrapX",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "closable": true,
        "minimizable": true,
        "maximizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$DATA/WrapX/backgrounds/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
